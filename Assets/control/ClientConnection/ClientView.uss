/* 加入房间界面：只保留本界面特有的布局，外观来自 TankTheme.uss */

.card {
    width: 640px;
    margin: 24px;
    padding: 34px 44px 30px 44px;
}

.title {
    margin-bottom: 4px;
}

.subtitle {
    margin-bottom: 24px;
}

/* 附近的房间：搜索到的房间列表 + 提示 */
.discover {
    flex-shrink: 0;
    margin-bottom: 18px;
}

.discover-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.discover-title {
    font-size: 22px;
    color: rgba(244, 239, 228, 0.85);
}

.discover-refresh {
    width: 88px;
    height: 34px;
    font-size: 19px;
    border-radius: 8px;
}

.room-list {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 0;
    /* 最多露两行，再多就列表内部滚动，避免卡片在小屏上超出画面 */
    max-height: 116px;
}

/* ListView 在没有条目时会自带一行“List is empty”，这行不受游戏语言控制。
   空状态由下面的 discoverHint 负责，把它隐藏掉。 */
.room-list .unity-list-view__empty-label {
    display: none;
}

.room-row {
    flex-direction: row;
    align-items: center;
    height: 52px;
    flex-shrink: 0;
    padding: 0 14px 0 14px;
    margin-bottom: 6px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.05);
    transition-property: background-color;
    transition-duration: 0.12s;
}

.room-row:hover {
    background-color: rgba(255, 255, 255, 0.10);
}

.room-main {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
}

.room-name {
    font-size: 23px;
    color: rgb(235, 235, 235);
    max-width: 260px;
}

.room-host {
    font-size: 18px;
    color: rgba(244, 239, 228, 0.5);
    margin-left: 12px;
    max-width: 150px;
}

.room-players {
    width: 64px;
    flex-shrink: 0;
    font-size: 19px;
    color: rgba(244, 239, 228, 0.65);
    -unity-text-align: middle-right;
}

.room-state {
    width: 64px;
    flex-shrink: 0;
    font-size: 18px;
    color: rgb(242, 181, 68);
    -unity-text-align: middle-right;
}

/* 已经开局的房间压暗一些，大厅里的房间更显眼 */
.room-row--in-game {
    opacity: 0.55;
}

.discover-hint {
    height: 22px;
    flex-shrink: 0;
    margin-top: 4px;
    font-size: 18px;
    color: rgba(244, 239, 228, 0.5);
    -unity-text-align: middle-left;
}

.discover-hint--error {
    color: rgb(240, 138, 118);
}

.row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 14px;
}

.field-label {
    width: 84px;
    flex-shrink: 0;
    font-size: 28px;
    color: rgba(244, 239, 228, 0.85);
    -unity-text-align: middle-right;
    margin-right: 18px;
}

.field {
    flex-grow: 1;
    flex-shrink: 0;
    height: 52px;
    margin: 0;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 26px;
    color: rgb(32, 36, 42);
    background-color: rgb(245, 242, 234);
    border-radius: 9px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
}

.field:hover {
    border-color: rgba(244, 239, 228, 0.40);
}

.field:focus {
    border-color: rgb(242, 181, 68);
}

/* 去掉运行时主题给输入区自带的底色和描边，只保留外层的圆角底色 */
.field .unity-base-text-field__input {
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
}

.placeholder {
    position: absolute;
    left: 12px;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
    font-size: 26px;
    color: rgba(120, 124, 130, 0.75);
}

.tip {
    height: 26px;
    flex-shrink: 0;
    font-size: 20px;
    color: rgba(244, 239, 228, 0.8);
    -unity-text-align: middle-center;
}

.tip--error {
    color: rgb(240, 138, 118);
}

.actions {
    flex-direction: row;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 18px;
}

.btn {
    width: 160px;
    margin: 0 13px;
}
