/* 加入房间界面：只保留本界面特有的布局，外观来自 TankTheme.uss */

.card {
    width: 640px;
    margin: 24px;
    padding: 34px 44px 30px 44px;
}

.title {
    margin-bottom: 4px;
}

.subtitle {
    margin-bottom: 24px;
}

.row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 14px;
}

.field-label {
    width: 84px;
    flex-shrink: 0;
    font-size: 28px;
    color: rgba(244, 239, 228, 0.85);
    -unity-text-align: middle-right;
    margin-right: 18px;
}

.field {
    flex-grow: 1;
    flex-shrink: 0;
    height: 52px;
    margin: 0;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 26px;
    color: rgb(32, 36, 42);
    background-color: rgb(245, 242, 234);
    border-radius: 9px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
}

.field:hover {
    border-color: rgba(244, 239, 228, 0.40);
}

.field:focus {
    border-color: rgb(242, 181, 68);
}

/* 去掉运行时主题给输入区自带的底色和描边，只保留外层的圆角底色 */
.field .unity-base-text-field__input {
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
}

.placeholder {
    position: absolute;
    left: 12px;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
    font-size: 26px;
    color: rgba(120, 124, 130, 0.75);
}

.tip {
    height: 26px;
    flex-shrink: 0;
    font-size: 20px;
    color: rgba(244, 239, 228, 0.8);
    -unity-text-align: middle-center;
}

.tip--error {
    color: rgb(240, 138, 118);
}

.actions {
    flex-direction: row;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 18px;
}

.btn {
    width: 160px;
    margin: 0 13px;
}
