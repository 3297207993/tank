<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/control/style/TankTheme.uss?fileID=7433441132597879392&amp;guid=e133886d60d50244fbbda625fd5e2c51&amp;type=3#TankTheme" />
    <Style src="project://database/Assets/control/ScoreTable/ScoreView.uss?fileID=7433441132597879392&amp;guid=7742d8241c4f4c909581ad8345c71888&amp;type=3#ScoreView" />
    <ui:VisualElement name="root" class="root tk-root">
        <ui:VisualElement name="scrim" class="score-scrim" picking-mode="Ignore" />
        <ui:VisualElement name="board" class="tk-card score-board">
            <ui:Label tabindex="-1" class="tk-title score-title" text="计分板" parse-escape-sequences="true" />
            <ui:Label tabindex="-1" class="tk-subtitle score-subtitle" text="先比击杀，再比存活；死亡越少越靠前" parse-escape-sequences="true" />
            <ui:VisualElement class="score-head">
                <ui:Label tabindex="-1" class="head-cell scol-rank" text="排名" parse-escape-sequences="true" />
                <ui:Label tabindex="-1" class="head-cell scol-name" text="玩家" parse-escape-sequences="true" />
                <ui:Label tabindex="-1" class="head-cell scol-kills" text="击杀" parse-escape-sequences="true" />
                <ui:Label tabindex="-1" class="head-cell scol-deaths" text="死亡" parse-escape-sequences="true" />
                <ui:Label tabindex="-1" class="head-cell scol-survivals" text="存活" parse-escape-sequences="true" />
            </ui:VisualElement>
            <ui:ListView name="list" class="score-list" virtualization-method="FixedHeight" fixed-item-height="66" />
            <ui:Button class="tk-btn tk-btn--ghost score-close" name="close" text="返回" parse-escape-sequences="true" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
