<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; background-color: rgba(57, 57, 57, 0);">
        <ui:ListView name="list" virtualization-method="DynamicHeight" style="flex-grow: 20;" />
        <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-items: center; justify-content: center; margin-right: 0;">
            <ui:Button text="ok" parse-escape-sequences="true" display-tooltip-when-elided="true" name="start" style="margin-right: 100px; padding-right: 10px; width: 100px; font-size: 32px;" />
            <ui:Button text="cancel" parse-escape-sequences="true" display-tooltip-when-elided="true" style="position: relative; margin-left: 100px; width: 100px; font-size: 32px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
