/* 房间大厅：盖住整个画面的深色底板 + 卡片 */

.lobby-screen {
    /* 用不透明底色：和开始/加入房间场景的深蓝保持一致，也不依赖半透明合成 */
    background-color: rgb(49, 77, 121);
}

.lobby-card {
    width: 760px;
    margin: 24px;
    padding: 30px 36px 26px 36px;
}

.lobby-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.player-count {
    flex-shrink: 0;
    font-size: 20px;
    color: rgb(242, 181, 68);
    background-color: rgba(242, 181, 68, 0.12);
    border-radius: 14px;
    padding: 4px 14px;
}

.lobby-subtitle {
    margin-top: 6px;
    margin-bottom: 20px;
}

/* 表头与行共用列宽，保证对齐 */
.list-head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 0 16px 8px 16px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.head-cell {
    font-size: 20px;
    color: rgba(244, 239, 228, 0.45);
}

.col-name {
    flex-grow: 1;
    flex-shrink: 1;
}

.col-id {
    width: 110px;
    flex-shrink: 0;
}

.col-score {
    width: 80px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.col-kick {
    width: 76px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.lobby-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 150px;
    max-height: 360px;
    margin-bottom: 8px;
}

/* 玩家行 */
.player-row {
    flex-direction: row;
    align-items: center;
    height: 64px;
    flex-shrink: 0;
    padding: 0 16px 0 16px;
    margin-bottom: 8px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    transition-property: background-color;
    transition-duration: 0.12s;
}

.player-row:hover {
    background-color: rgba(255, 255, 255, 0.09);
}

.player-row--local {
    background-color: rgba(242, 181, 68, 0.10);
}

.player-main {
    flex-direction: row;
    align-items: center;
}

.player-name {
    font-size: 30px;
    color: rgb(235, 235, 235);
    max-width: 320px;
}

.player-role {
    flex-shrink: 0;
    font-size: 18px;
    color: rgb(242, 181, 68);
    background-color: rgba(242, 181, 68, 0.14);
    border-radius: 8px;
    padding: 2px 10px;
    margin-left: 12px;
}

.player-id {
    font-size: 20px;
    color: rgba(244, 239, 228, 0.45);
}

.player-score {
    font-size: 30px;
    color: rgb(242, 181, 68);
}

.player-kick {
    width: 76px;
    height: 36px;
    font-size: 20px;
    border-radius: 8px;
}

.is-hidden {
    display: none;
}

.lobby-hint {
    flex-shrink: 0;
    height: 26px;
    font-size: 19px;
    color: rgba(244, 239, 228, 0.55);
}

.lobby-hint--ready {
    color: rgb(242, 181, 68);
}

.lobby-actions {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    margin-top: 14px;
}

.lobby-btn {
    width: 150px;
    margin-left: 14px;
}
