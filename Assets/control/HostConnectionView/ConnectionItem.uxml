<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/control/style/TankTheme.uss?fileID=7433441132597879392&amp;guid=e133886d60d50244fbbda625fd5e2c51&amp;type=3#TankTheme" />
    <Style src="project://database/Assets/control/HostConnectionView/ConnectionView.uss?fileID=7433441132597879392&amp;guid=7317b90bd147d9c4ab7b548591479891&amp;type=3#ConnectionView" />
    <ui:VisualElement name="row" class="player-row">
        <ui:VisualElement class="col-name player-main">
            <ui:Label tabindex="-1" name="name" class="player-name" text="玩家" parse-escape-sequences="true" display-tooltip-when-elided="true" />
            <ui:Label tabindex="-1" name="role" class="player-role is-hidden" text="" parse-escape-sequences="true" />
        </ui:VisualElement>
        <ui:Label tabindex="-1" name="id" class="col-id player-id" text="ID: 0" parse-escape-sequences="true" />
        <ui:Button class="tk-btn tk-btn--danger col-kick player-kick" name="kick" text="踢出" parse-escape-sequences="true" />
    </ui:VisualElement>
</ui:UXML>
