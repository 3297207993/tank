/* 开始菜单：居中的竖排卡片 */

/* 封面背景：全屏铺满（scale-and-crop 会裁掉多余部分，不变形），
   图片由 Tools/tank_art/gen_menu_bg.py 生成。 */
.start-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/control/StartScene/start_bg.png?fileID=2800000&guid=7f3c2a91d45b4e6f8a12c3d4e5b60718&type=3");
    -unity-background-scale-mode: scale-and-crop;
}

/* 压一层冷色遮罩，让卡片和文字在任何显示器上都够清楚 */
.start-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 14, 24, 0.30);
}

.start-card {
    width: 520px;
    margin: 24px;
    padding: 52px 56px 36px 56px;
    align-items: center;
}

.start-title {
    flex-shrink: 0;
    font-size: 68px;
    color: rgb(244, 239, 228);
    -unity-text-align: middle-center;
}

.start-subtitle {
    margin-top: 12px;
    margin-bottom: 44px;
    -unity-text-align: middle-center;
}

.start-btn {
    width: 300px;
    height: 56px;
    font-size: 30px;
    margin-bottom: 16px;
}

.start-quit {
    width: 120px;
    height: 40px;
    font-size: 22px;
    margin-top: 14px;
}
