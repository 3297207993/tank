/[Aa]ssets/[Ss]treamingAssets/aa/*

# End of https://www.toptal.com/developers/gitignore/api/unity

# Unity UI Builder generated schema (regenerated per Unity version)
/[Uu]IElementsSchema/

# Art tool scratch output (previews generated by Tools/tank_art/preview_menu.py)
/Tools/tank_art/out/

# NuGet assemblies auto-restored by com.ivanmurzak.unity.mcp
/[Aa]ssets/Plugins/NuGet/
/[Aa]ssets/Plugins/NuGet.meta

.mcp.json

# Release packaging output (produced by .github/workflows/release.yml)
